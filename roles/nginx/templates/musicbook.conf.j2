# MusicBook Reverse Proxy Configuration

# 1. Subdomain routing on Port 80 (e.g., musicbook.34.229.18.255.nip.io or musicbook.yourdomain.com)
server {
    listen 80;
    server_name ~^musicbook\..*$;

    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:{{ item.service_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Real-Time WebSocket forwarding (Socket.io)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:{{ item.websocket_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# 2. Direct Port routing on Port 8000 (e.g., http://34.229.18.255:8000/)
server {
    listen 8000;
    server_name _;

    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:{{ item.service_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Real-Time WebSocket forwarding (Socket.io)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:{{ item.websocket_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
