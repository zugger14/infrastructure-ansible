# AMS (Appointment Management System) Reverse Proxy Configuration

# 1. Subdomain routing on Port 80 (e.g., ams.34.229.18.255.nip.io or ams.yourdomain.com)
server {
    listen 80;
    server_name ~^ams\..*$;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:{{ item.service_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 2. Direct Port routing on Port 8080 (e.g., http://34.229.18.255:8080/)
server {
    listen 8080;
    server_name _;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:{{ item.service_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
