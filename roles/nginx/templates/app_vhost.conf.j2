# ==============================================================================
# Unified Generic Nginx Reverse Proxy Template for: {{ item.name }}
# Generated automatically by Ansible. Do NOT edit manually on the server.
# ==============================================================================

{% set sub = item.subdomain | default(item.name) %}
{% set client_body = item.client_max_body_size | default('50M') %}

{# ------------------------------------------------------------- #}
{# 1. SUBDOMAIN ROUTING (e.g. {{ sub }}.*.nip.io or {{ sub }}.domain.com) #}
{# ------------------------------------------------------------- #}
server {
    listen 80;
    server_name ~^{{ sub }}\..*$;

    client_max_body_size {{ client_body }};

    location / {
        proxy_pass http://127.0.0.1:{{ item.service_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

{% if item.websocket_port is defined %}
    # Real-Time WebSocket forwarding
    location {{ item.websocket_path | default('/socket.io/') }} {
        proxy_pass http://127.0.0.1:{{ item.websocket_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
{% endif %}
}

{# ------------------------------------------------------------- #}
{# 2. DIRECT PORT ROUTING (Optional dedicated external port)     #}
{# ------------------------------------------------------------- #}
{% if item.direct_port is defined %}
server {
    listen {{ item.direct_port }};
    server_name _;

    client_max_body_size {{ client_body }};

    location / {
        proxy_pass http://127.0.0.1:{{ item.service_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

{% if item.websocket_port is defined %}
    # Real-Time WebSocket forwarding
    location {{ item.websocket_path | default('/socket.io/') }} {
        proxy_pass http://127.0.0.1:{{ item.websocket_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
{% endif %}
}
{% endif %}
